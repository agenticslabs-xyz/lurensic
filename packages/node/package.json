{
  "name": "@agenticslabs/lurensic",
  "version": "0.1.0",
  "description": "Lurensic runtime for Node, Bun, Deno and Cloudflare Workers. The engine, the onDetect callback, event sinks, a web-standard fetch adapter and the CLI, for deception-based detection of AI-driven and automated attacks.",
  "license": "Apache-2.0",
  "author": "Agentics Labs (https://agenticslabs.xyz)",
  "homepage": "https://github.com/agenticslabs-xyz/lurensic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticslabs-xyz/lurensic.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/agenticslabs-xyz/lurensic/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/workerd.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lurensic": "./dist/cli.js"
  },
  "files": [
    "dist",
    "wasm",
    "src",
    "!src/engine-bytes.ts"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/workerd.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "security",
    "deception",
    "honeypot",
    "honeytoken",
    "ai-agents",
    "waf",
    "intrusion-detection",
    "cloudflare-workers",
    "deno",
    "bun",
    "fetch"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "publishConfig": {
    "access": "public"
  }
}
