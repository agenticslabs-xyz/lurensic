{
  "name": "@agenticslabs/kagami-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare enforcement for Kagami. Machines Kagami contains are added to a Cloudflare IP list, so a WAF rule stops them at the edge.",
  "license": "Apache-2.0",
  "author": "Agentics Labs (https://agenticslabs.xyz)",
  "homepage": "https://github.com/agenticslabs-xyz/kagami#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticslabs-xyz/kagami.git",
    "directory": "packages/cloudflare"
  },
  "bugs": {
    "url": "https://github.com/agenticslabs-xyz/kagami/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kagami-cloudflare": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cloudflare",
    "waf",
    "security",
    "deception",
    "ai-agents",
    "blocklist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@agenticslabs/kagami": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
